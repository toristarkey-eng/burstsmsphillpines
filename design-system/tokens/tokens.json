{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Burst SMS Philippines",
    "version": "0.1.0",
    "description": "Hybrid Burst SMS and Kudosity foundation tokens for the Philippines market."
  },
  "color": {
    "brand": {
      "navy": { "$type": "color", "$value": "#002A66" },
      "violet": { "$type": "color", "$value": "#4C23CC" },
      "cyan": { "$type": "color", "$value": "#00AEC4" },
      "blue": { "$type": "color", "$value": "#005677" },
      "blush": { "$type": "color", "$value": "#FFB3B3" },
      "mint": { "$type": "color", "$value": "#0AD17A" }
    },
    "neutral": {
      "ink": { "$type": "color", "$value": "#121217" },
      "slate": { "$type": "color", "$value": "#575762" },
      "line": { "$type": "color", "$value": "#DADCE8" },
      "cloud": { "$type": "color", "$value": "#F4F5FF" },
      "canvas": { "$type": "color", "$value": "#F7F8FE" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "semantic": {
      "text": { "$type": "color", "$value": "{color.neutral.ink}" },
      "heading": { "$type": "color", "$value": "{color.brand.navy}" },
      "action": { "$type": "color", "$value": "{color.brand.violet}" },
      "link": { "$type": "color", "$value": "{color.brand.blue}" },
      "focus": { "$type": "color", "$value": "{color.brand.cyan}" },
      "positive": { "$type": "color", "$value": "{color.brand.mint}" },
      "surface": { "$type": "color", "$value": "{color.neutral.white}" },
      "surfaceSubtle": { "$type": "color", "$value": "{color.neutral.cloud}" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Noto Sans", "Segoe UI", "Arial", "sans-serif"] },
      "legacy": { "$type": "fontFamily", "$value": ["Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "lead": { "$type": "dimension", "$value": "1.25rem" },
      "h3": { "$type": "dimension", "$value": "1.75rem" },
      "h2": { "$type": "dimension", "$value": "clamp(2.25rem, 5vw, 3.25rem)" },
      "display": { "$type": "dimension", "$value": "clamp(3rem, 7vw, 5rem)" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.5rem" },
    "md": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.5rem" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "soft": { "$type": "shadow", "$value": { "color": "#002A661A", "offsetX": "0px", "offsetY": "16px", "blur": "42px", "spread": "0px" } },
    "lifted": { "$type": "shadow", "$value": { "color": "#12121724", "offsetX": "0px", "offsetY": "22px", "blur": "60px", "spread": "-12px" } }
  },
  "motion": {
    "quick": { "$type": "duration", "$value": "140ms" },
    "standard": { "$type": "duration", "$value": "240ms" },
    "slow": { "$type": "duration", "$value": "420ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  }
}

